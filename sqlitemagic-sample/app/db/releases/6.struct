{"tables":{"todo_list":{"name":"todo_list","schema":"CREATE TABLE IF NOT EXISTS \"todo_list\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL DEFAULT '')","columns":[{"id":true,"autoIncrement":true,"name":"id","onDeleteCascade":false,"sqlType":"INTEGER","schema":"\"id\" INTEGER PRIMARY KEY AUTOINCREMENT","notNull":false,"notNullDefault":null},{"id":false,"autoIncrement":false,"name":"name","onDeleteCascade":false,"sqlType":"TEXT","schema":"\"name\" TEXT NOT NULL DEFAULT ''","notNull":true,"notNullDefault":"''"}]},"todo_item":{"name":"todo_item","schema":"CREATE TABLE IF NOT EXISTS \"todo_item\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL DEFAULT '', \"list\" INTEGER NOT NULL REFERENCES \"todo_list\"(\"id\") ON DELETE CASCADE, \"completed\" INTEGER NOT NULL DEFAULT 0)","columns":[{"id":true,"autoIncrement":true,"name":"id","onDeleteCascade":false,"sqlType":"INTEGER","schema":"\"id\" INTEGER PRIMARY KEY AUTOINCREMENT","notNull":false,"notNullDefault":null},{"id":false,"autoIncrement":false,"name":"title","onDeleteCascade":false,"sqlType":"TEXT","schema":"\"title\" TEXT NOT NULL DEFAULT ''","notNull":true,"notNullDefault":"''"},{"id":false,"autoIncrement":false,"name":"list","onDeleteCascade":true,"sqlType":"INTEGER","schema":"\"list\" INTEGER NOT NULL REFERENCES \"todo_list\"(\"id\") ON DELETE CASCADE","notNull":true,"notNullDefault":null},{"id":false,"autoIncrement":false,"name":"completed","onDeleteCascade":false,"sqlType":"INTEGER","schema":"\"completed\" INTEGER NOT NULL DEFAULT 0","notNull":true,"notNullDefault":"0"}]}},"indices":{"index_todo_item_list":{"name":"index_todo_item_list","indexSql":"CREATE INDEX IF NOT EXISTS main.\"index_todo_item_list\" ON \"todo_item\" (\"list\")","forTable":"todo_item"}},"temporaryTables":{},"temporaryIndices":{},"views":{"todo_list_summary":{"name":"todo_list_summary","moduleName":null}},"temporaryViews":{},"fullTextIndices":{"todo_item_fts":{"name":"todo_item_fts","forTable":"todo_item","tableSql":"CREATE VIRTUAL TABLE IF NOT EXISTS main.\"todo_item_fts\" USING fts5(\"title\", content='todo_item', content_rowid='id', tokenize='porter unicode61')","triggers":{"todo_item_fts_ai":"CREATE TRIGGER IF NOT EXISTS main.\"todo_item_fts_ai\" AFTER INSERT ON \"todo_item\" BEGIN INSERT INTO \"todo_item_fts\"(rowid, \"title\") VALUES (new.\"id\", new.\"title\"); END","todo_item_fts_ad":"CREATE TRIGGER IF NOT EXISTS main.\"todo_item_fts_ad\" AFTER DELETE ON \"todo_item\" BEGIN INSERT INTO \"todo_item_fts\"(\"todo_item_fts\", rowid, \"title\") VALUES ('delete', old.\"id\", old.\"title\"); END","todo_item_fts_au":"CREATE TRIGGER IF NOT EXISTS main.\"todo_item_fts_au\" AFTER UPDATE OF \"id\", \"title\", rowid, oid, _rowid_ ON \"todo_item\" WHEN old.\"id\" IS NOT new.\"id\" OR old.\"title\" IS NOT new.\"title\" BEGIN INSERT INTO \"todo_item_fts\"(\"todo_item_fts\", rowid, \"title\") VALUES ('delete', old.\"id\", old.\"title\"); INSERT INTO \"todo_item_fts\"(rowid, \"title\") VALUES (new.\"id\", new.\"title\"); END"},"shadowTables":["todo_item_fts_data","todo_item_fts_idx","todo_item_fts_docsize","todo_item_fts_config"]}}}